<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- An auditor sees only the VME's of his running mandates; after the last one he loses access. -->
        <record id="ir_cron_auditor_access" model="ir.cron">
            <field name="name">VME: leestoegang commissarissen bijwerken</field>
            <field name="model_id" ref="model_vme_mandate"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_auditor_access()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
