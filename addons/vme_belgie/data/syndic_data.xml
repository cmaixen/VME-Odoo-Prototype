<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="folder_syndic" model="vme.document.folder">
            <field name="name">Syndicus</field>
            <field name="sequence">15</field>
        </record>

        <record id="ir_cron_syndic_mandate" model="ir.cron">
            <field name="name">VME: herbenoeming en aanplakking syndicus</field>
            <field name="model_id" ref="model_vme_syndic_mandate"/>
            <field name="state">code</field>
            <field name="code">model._cron_schedule_mandate_activities()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
