<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_assembly_convocation" model="ir.actions.report">
        <field name="name">Oproeping AV</field>
        <field name="model">vme.assembly.convocation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vme_belgie.report_assembly_convocation</field>
        <field name="report_file">vme_belgie.report_assembly_convocation</field>
        <field name="print_report_name">'Oproeping AV %s %s' % (object.assembly_id.year, object.partner_id.name)</field>
        <field name="binding_model_id" ref="model_vme_assembly_convocation"/>
    </record>

    <record id="action_report_assembly_minutes" model="ir.actions.report">
        <field name="name">Notulen AV</field>
        <field name="model">vme.assembly</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vme_belgie.report_assembly_minutes</field>
        <field name="report_file">vme_belgie.report_assembly_minutes</field>
        <field name="print_report_name">'Notulen %s' % object.name</field>
        <field name="binding_model_id" ref="model_vme_assembly"/>
    </record>

    <template id="report_assembly_agenda">
        <table class="table table-sm">
            <thead><tr><th>Nr.</th><th>Agendapunt</th><th>Vereiste meerderheid</th></tr></thead>
            <tbody>
                <tr t-foreach="assembly.item_ids" t-as="item">
                    <td t-out="item.sequence"/>
                    <td>
                        <span t-out="item.name"/><t t-if="item.allow_advance_vote"> *</t>
                        <div t-if="item.description" class="text-muted small" t-out="item.description"/>
                    </td>
                    <td><span t-field="item.majority"/></td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_assembly_convocation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="assembly" t-value="o.assembly_id"/>
                <t t-set="vme" t-value="assembly.association_id"/>
                <t t-set="company" t-value="vme.company_id"/>
                <t t-call="vme_belgie.report_assembly_convocation_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- In the language of the recipient: see docs/dev/vertaling.md -->
    <template id="report_assembly_convocation_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="row mb-4">
                    <div class="col-6">
                        <h2 class="mb-0">Oproeping</h2>
                        <div class="text-muted"><t t-if="assembly.assembly_type == 'extraordinary'">Buitengewone algemene vergadering</t><t t-else="">Gewone algemene vergadering</t> <t t-out="assembly.year"/><t t-if="assembly.subject">: <t t-out="assembly.subject"/></t></div>
                        <div class="text-muted">VME <t t-out="vme.name"/><t t-if="vme.kbo_number"> · KBO <t t-out="vme.kbo_number"/></t></div>
                    </div>
                    <div class="col-5 offset-1">
                        <strong t-out="o.partner_id.name"/>
                        <div class="text-muted">Kavels: <t t-out="o.lot_names"/></div>
                    </div>
                </div>
                <p>Beste mede-eigenaar,</p>
                <p>
                    <t t-if="assembly.assembly_type == 'extraordinary'">De syndicus nodigt u uit op de buitengewone algemene vergadering van de VME</t>
                    <t t-else="">De syndicus nodigt u uit op de gewone algemene vergadering van de VME</t> <t t-out="vme.name"/>
                    op <strong><span t-field="assembly.datetime_start" t-options="{'tz_name': 'Europe/Brussels', 'format': 'EEEE d MMMM yyyy'}"/> om <span t-field="assembly.datetime_start" t-options="{'tz_name': 'Europe/Brussels', 'format': 'HH:mm'}"/></strong>,
                    <t t-if="assembly.slot_id.location_type == 'room'">
                        in <strong t-out="assembly.slot_id.room_id.name"/><t t-if="assembly.slot_id.room_id.address">, <t t-out="assembly.slot_id.room_id.address"/></t>.
                    </t>
                    <t t-else="">online.</t>
                </p>
                <p t-if="assembly.meeting_mode != 'in_person'">
                    <t t-if="assembly.meeting_mode == 'hybrid'">U kunt ook online deelnemen en stemmen.</t>
                    <t t-else="">U neemt online deel en stemt in het eigenaarsportaal.</t>
                    Gebruik daarvoor deze link en meld u aan in het eigenaarsportaal:
                    <strong t-out="assembly.online_url"/>. Online aanwezigen tellen mee voor het quorum.
                </p>
                <p t-if="assembly.item_ids.filtered('allow_advance_vote')">
                    Over de punten met een * kunt u vooraf schriftelijk stemmen in het eigenaarsportaal, tot de vergadering begint.
                </p>
                <p>
                    U beschikt over <strong t-out="'%g' % o.shares"/> stemmen (quotiteiten in de gemene delen).
                    Kunt u niet aanwezig zijn, dan kunt u zich laten vertegenwoordigen met het volmachtformulier in bijlage.
                </p>
                <h5>Agenda</h5>
                <t t-call="vme_belgie.report_assembly_agenda"/>
                <p class="small text-muted">
                    Een volmachthouder mag niet meer dan drie volmachten aannemen, tenzij hij met zijn eigen stemmen
                    en die van zijn volmachtgevers niet meer dan 10% van alle stemmen heeft.
                    <t t-if="assembly.assembly_type == 'ordinary'">Uw jaarafrekening van <t t-out="assembly.year - 1"/> zit als aparte bijlage bij deze oproeping.</t>
                </p>
                <p>Met vriendelijke groeten,<br/>De syndicus</p>

                <div style="page-break-before: always;"/>
                <h2>Volmacht</h2>
                <p>Ondergetekende, <strong t-out="o.partner_id.name"/>, eigenaar van kavel(s) <t t-out="o.lot_names"/>
                    in de VME <t t-out="vme.name"/>, geeft volmacht aan</p>
                <p class="mt-4">Naam: ..............................................................................................</p>
                <p>om hem of haar te vertegenwoordigen op de algemene vergadering van
                    <span t-field="assembly.date"/>, deel te nemen aan de beraadslaging en te stemmen over de agendapunten:</p>
                <table class="table table-sm">
                    <thead><tr><th>Nr.</th><th>Agendapunt</th><th class="text-center">Voor</th><th class="text-center">Tegen</th><th class="text-center">Onthouding</th></tr></thead>
                    <tbody>
                        <tr t-foreach="assembly.item_ids.filtered(lambda i: i.majority != 'none')" t-as="item">
                            <td t-out="item.sequence"/>
                            <td t-out="item.name"/>
                            <td class="text-center">☐</td><td class="text-center">☐</td><td class="text-center">☐</td>
                        </tr>
                    </tbody>
                </table>
                <p class="small text-muted">Kruist u niets aan, dan stemt de volmachthouder naar eigen inzicht.</p>
                <div class="row mt-5">
                    <div class="col-6">Datum: ........................................</div>
                    <div class="col-6">Handtekening: ........................................</div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_assembly_minutes">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="assembly">
                <t t-set="vme" t-value="assembly.association_id"/>
                <t t-set="company" t-value="vme.company_id"/>
                <t t-call="vme_belgie.report_assembly_minutes_document" t-lang="company.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- In the language of the recipient: see docs/dev/vertaling.md -->
    <template id="report_assembly_minutes_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="mb-0">Notulen</h2>
                <div class="text-muted mb-3">
                    <t t-if="assembly.assembly_type == 'extraordinary'">Buitengewone algemene vergadering</t><t t-else="">Gewone algemene vergadering</t> <t t-out="assembly.year"/><t t-if="assembly.subject">: <t t-out="assembly.subject"/></t> · VME <t t-out="vme.name"/>
                    <t t-if="vme.kbo_number"> · KBO <t t-out="vme.kbo_number"/></t>
                </div>
                <p>
                    Vergadering van <span t-field="assembly.datetime_start" t-options="{'tz_name': 'Europe/Brussels', 'format': 'd MMMM yyyy'}"/> om <span t-field="assembly.datetime_start" t-options="{'tz_name': 'Europe/Brussels', 'format': 'HH:mm'}"/>
                    in <t t-out="assembly.location"/><t t-if="assembly.meeting_mode == 'hybrid'"> en online</t>.
                    <t t-if="assembly.chair_id">Voorzitter: <t t-out="assembly.chair_id.name"/>.</t>
                    <t t-if="assembly.secretary_id">Secretaris: <t t-out="assembly.secretary_id.name"/>.</t>
                </p>

                <h5>Aanwezigheid en quorum</h5>
                <p>
                    Aanwezig of vertegenwoordigd: <t t-out="assembly.quorum_text"/>.
                    <strong t-if="assembly.quorum_reached">Het quorum is bereikt; de vergadering kan geldig beraadslagen.</strong>
                    <strong t-else="">Het quorum is niet bereikt.</strong>
                    <t t-if="assembly.second_session">(Tweede vergadering: geen quorumvereiste.)</t>
                </p>
                <table class="table table-sm mb-4">
                    <thead><tr><th>Eigenaar</th><th>Kavels</th><th class="text-end">Quotiteiten</th><th>Aanwezigheid</th></tr></thead>
                    <tbody>
                        <tr t-foreach="assembly.attendee_ids" t-as="att">
                            <td t-out="att.partner_id.name"/>
                            <td t-out="att.lot_names"/>
                            <td class="text-end" t-out="'%g' % att.shares"/>
                            <td>
                                <span t-field="att.attendance"/>
                                <t t-if="att.attendance == 'present' and att.attendance_mode in ('online', 'written')"> (<span t-field="att.attendance_mode"/>)</t>
                                <t t-if="att.attendance == 'represented'"> door <t t-out="att.proxy_holder_id.name"/></t>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h5>Beraadslaging en beslissingen</h5>
                <div t-foreach="assembly.item_ids" t-as="item" class="mb-3" style="page-break-inside: avoid;">
                    <strong><t t-out="item.sequence"/>. <t t-out="item.name"/></strong>
                    <span t-if="item.decision_number" class="text-muted"> (beslissing <t t-out="item.decision_number"/>)</span>
                    <div t-if="item.description" class="small" t-out="item.description"/>
                    <div t-if="item.majority != 'none'">
                        Vereiste meerderheid: <span t-field="item.majority"/>.
                        Voor: <t t-out="'%g' % item.votes_for"/>, tegen: <t t-out="'%g' % item.votes_against"/>,
                        onthouding: <t t-out="'%g' % item.votes_abstain"/>.
                        <strong>Uitslag: <span t-field="item.outcome"/>.</strong>
                        <t t-set="remote_votes" t-value="item.vote_ids.filtered(lambda v: v.source != 'room')"/>
                        <span t-if="remote_votes" class="small text-muted">
                            (<t t-out="len(remote_votes.filtered(lambda v: v.source == 'online'))"/> online en
                            <t t-out="len(remote_votes.filtered(lambda v: v.source == 'written'))"/> schriftelijke stemmen
                            via het portaal<t t-if="item.voting_closed_at">, stemming gesloten om
                            <span t-field="item.voting_closed_at" t-options="{'tz_name': 'Europe/Brussels', 'format': 'HH:mm'}"/></t>.)
                        </span>
                        <div t-if="item.vote_ids.filtered(lambda v: v.vote != 'for')" class="small text-muted">
                            Tegen of onthouding:
                            <t t-out="', '.join('%s (%s)' % (v.partner_id.name, dict(v._fields['vote']._description_selection(v.env))[v.vote].lower()) for v in item.vote_ids.filtered(lambda v: v.vote != 'for'))"/>
                        </div>
                    </div>
                    <div t-if="item.decision"><em t-out="item.decision"/></div>
                </div>

                <p t-if="assembly.meeting_mode != 'in_person'" class="small text-muted mt-4">
                    Deze notulen kunnen elektronisch ondertekend worden in het eigenaarsportaal. Het auditspoor
                    (naam, tijdstip, IP-adres en SHA-256 van deze PDF per ondertekenaar) bewaart de syndicus.
                </p>
                <div class="row mt-5" style="page-break-inside: avoid;">
                    <div class="col-4">De voorzitter</div>
                    <div class="col-4">De secretaris</div>
                    <div class="col-4">De aanwezige mede-eigenaars</div>
                </div>
            </div>
        </t>
    </template>
</odoo>
