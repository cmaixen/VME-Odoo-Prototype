<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_works_comparison" model="ir.actions.report">
        <field name="name">Offertevergelijking</field>
        <field name="model">vme.works.comparison</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vme_belgie.report_works_comparison</field>
        <field name="report_file">vme_belgie.report_works_comparison</field>
        <field name="print_report_name">object.name</field>
        <field name="binding_model_id" ref="model_vme_works_comparison"/>
    </record>

    <!-- The table, shared by the form in Odoo (links to the page of each PDF) and the PDF report. -->
    <template id="works_comparison_table">
        <t t-set="columns" t-value="o._columns()"/>
        <table class="table table-sm table-bordered o_vme_works_comparison" style="font-size: 0.85em;">
            <thead>
                <tr>
                    <th style="width: 18%;"/>
                    <th t-foreach="columns" t-as="column" style="padding: 3px 6px;">
                        <span t-out="column.display_name"/>
                        <div class="fw-normal text-muted small">
                            <t t-if="column.reference">Offerte <t t-out="column.reference"/></t>
                            <t t-if="column.quote_date"> van <span t-field="column.quote_date"/></t>
                        </div>
                        <div t-if="links and column.attachment_id" class="fw-normal small">
                            <a t-att-href="column._page_url(0)" target="_blank"><i class="fa fa-file-pdf-o"/> <t t-out="column.attachment_id.name"/></a>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="o._table_sections()" t-as="section">
                    <tr class="table-light">
                        <td t-att-colspan="len(columns) + 1" class="fw-bold" style="padding: 3px 6px; background-color: #f2f2f2;" t-out="section[0]"/>
                    </tr>
                    <tr t-foreach="section[1]" t-as="line">
                        <td style="padding: 3px 6px;" t-out="line.name"/>
                        <t t-foreach="line._cells(columns)" t-as="cell">
                            <t t-set="status" t-value="cell[3]"/>
                            <!-- Inline colours as well: wkhtmltopdf does not apply the Bootstrap table variables. -->
                            <td t-att-class="{'missing': 'table-danger', 'attention': 'table-warning', 'empty': 'text-muted'}.get(status, '')"
                                t-att-style="'padding: 3px 6px;' + {'missing': ' background-color: #f8d7da;', 'attention': ' background-color: #fff3cd;'}.get(status, '')">
                                <span style="white-space: pre-line;" t-out="cell[1] or '-'"/>
                                <t t-if="cell[2]">
                                    <a t-if="links and cell[0].attachment_id" t-att-href="cell[0]._page_url(cell[2])" target="_blank"
                                       class="small text-nowrap">(p. <t t-out="cell[2]"/>)</a>
                                    <span t-else="" class="small text-muted text-nowrap">(p. <t t-out="cell[2]"/>)</span>
                                </t>
                            </td>
                        </t>
                    </tr>
                </t>
            </tbody>
        </table>
        <div class="small text-muted">
            (p. N): pagina in de PDF van die offerte. Rood: ontbreekt ten opzichte van de andere offertes.
            Geel: nakijken (bv. een ander btw-tarief of een voorbehoud).
        </div>
    </template>

    <template id="report_works_comparison">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="vme_belgie.report_works_comparison_document" t-lang="company.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- In the language of the VME: see docs/dev/vertaling.md -->
    <template id="report_works_comparison_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div t-if="o.state != 'approved'" class="alert alert-warning text-center fw-bold">
                    CONCEPT: nog niet goedgekeurd door de syndicus
                </div>
                <h2 class="mb-0">Vergelijking van de offertes</h2>
                <div class="text-muted"><t t-out="o.works_id.name"/> · VME <t t-out="o.association_id.name"/></div>
                <div t-if="o.assembly_id" class="text-muted">Bijlage bij de oproeping van <t t-out="o.assembly_id.display_name"/></div>

                <h5 class="mt-4">Samenvatting</h5>
                <p style="white-space: pre-line;" t-out="o.summary"/>

                <h5 class="mt-3">Overzicht per post</h5>
                <t t-call="vme_belgie.works_comparison_table"><t t-set="links" t-value="False"/></t>

                <p class="mt-4 small">
                    Deze vergelijking somt de verschillen tussen de offertes op en bevat geen aanbeveling: de algemene
                    vergadering kiest. De gegevens zijn uit de offertes gelezen met hulp van AI en nagekeken door de syndicus.
                    Bij een verschil geldt de tekst van de offerte zelf.
                </p>
                <p t-if="o.approved_by_id" class="small text-muted">
                    Nagekeken en goedgekeurd door <t t-out="o.approved_by_id.name"/> op <span t-field="o.approved_date" t-options="{'widget': 'date'}"/>.
                </p>
            </div>
        </t>
    </template>
</odoo>
