<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every VME is a company. A user only reaches the VME records of the companies he is allowed in
         (user.company_ids), not only those selected in the company switcher: lists and computations
         across VMEs keep working for staff with every VME, and staff with some VMEs see only those.
         Global rules (no group) are combined with AND with every group rule, so the auditor's rules
         (vme_council_security.xml) stay in force. Every new vme model with a company needs one here;
         tests/test_access_rules.py fails otherwise. See docs/dev/toegangsrechten.md. -->
    <record id="rule_company_association" model="ir.rule">
        <field name="name">VME: vme.association van de companies van de gebruiker</field>
        <field name="model_id" ref="model_vme_association"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

