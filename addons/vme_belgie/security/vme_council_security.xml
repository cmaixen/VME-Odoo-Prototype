<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The auditor (commissaris van de rekeningen) is an internal user who may only read the
         VME's of his own mandates. Staff keep their access: these rules only apply to this group.
         Rules of one group are combined with OR, so every model gets one rule that limits reading
         to his companies and one that refuses every write, create and delete. -->
    <record id="res_groups_privilege_vme" model="res.groups.privilege">
        <field name="name">VME</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_vme_auditor" model="res.groups">
        <field name="name">Commissaris van de rekeningen</field>
        <field name="privilege_id" ref="res_groups_privilege_vme"/>
        <field name="comment">Leest de boekhouding, facturen en bankafschriften van zijn VME's, zonder iets te wijzigen.</field>
        <!-- Read-only accounting, which implies an internal user. -->
        <field name="implied_ids" eval="[Command.link(ref('account.group_account_readonly'))]"/>
    </record>

    <!-- Partners: only his own, the VME companies, the owners and suppliers of his VME's, and the
         syndic's staff (they follow the records, and the chatter reads its followers). -->
    <record id="rule_auditor_read_partner" model="ir.rule">
        <field name="name">Commissaris: partners van zijn VME's</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[Command.link(ref('group_vme_auditor'))]"/>
        <field name="domain_force">['|', '|', '|', '|', '|', '|',
            ('id', '=', user.partner_id.id),
            ('user_ids.share', '=', False),
            ('company_id', 'in', company_ids),
            ('ref_company_ids', 'in', company_ids),
            ('vme_ownership_ids.company_id', 'in', company_ids),
            ('vme_mandate_ids.company_id', 'in', company_ids),
            ('invoice_ids.company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

