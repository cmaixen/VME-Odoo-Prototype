        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_auditor_no_write_works_comparison" model="ir.rule">
        <field name="name">Commissaris: geen wijzigingen aan vme.works.comparison</field>
        <field name="model_id" ref="model_vme_works_comparison"/>
        <field name="groups" eval="[Command.link(ref('group_vme_auditor'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
