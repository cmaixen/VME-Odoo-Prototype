        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_auditor_read_works_comparison_column" model="ir.rule">
        <field name="name">Commissaris: vme.works.comparison.column van zijn VME's</field>
        <field name="model_id" ref="model_vme_works_comparison_column"/>
        <field name="groups" eval="[Command.link(ref('group_vme_auditor'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_company_works_comparison_line" model="ir.rule">
        <field name="name">VME: vme.works.comparison.line van de companies van de gebruiker</field>
        <field name="model_id" ref="model_vme_works_comparison_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_auditor_read_works_comparison_line" model="ir.rule">
        <field name="name">Commissaris: vme.works.comparison.line van zijn VME's</field>
        <field name="model_id" ref="model_vme_works_comparison_line"/>
        <field name="groups" eval="[Command.link(ref('group_vme_auditor'))]"/>
