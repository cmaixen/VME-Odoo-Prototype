<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vme_ai" model="ir.ui.view">
        <field name="name">account.move.form.vme.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_vme_ai_mark_reviewed" type="object" string="Waarschuwingen nagekeken"
                        class="btn-primary" invisible="not vme_ai_danger_count or vme_ai_reviewed_by_id or state != 'draft'"
                        confirm="Heb je de leverancier en het IBAN gecontroleerd via een gekend nummer of adres? Het IBAN van de factuur wordt daarmee niet opgeslagen."/>
                <button name="action_vme_ai_recheck" type="object" string="Opnieuw controleren"
                        class="btn-secondary" invisible="vme_ai_state != 'read' or state != 'draft'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="vme_ai_state != 'to_read'">
                    Deze factuur kwam binnen als PDF zonder UBL. De AI-assistent leest ze en vult ze in als concept.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="vme_ai_state != 'read' or not vme_ai_danger_count or vme_ai_reviewed_by_id">
                    <strong>Let op:</strong> de AI-lezing vond <field name="vme_ai_danger_count" class="d-inline"/>
                    gevaar (nieuwe leverancier of ander IBAN). Betaal nooit naar een IBAN dat alleen op de factuur staat:
                    bel de leverancier op een gekend nummer. Zie het tabblad "AI-lezing".
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="vme_ai_state != 'read' or vme_ai_danger_count or not vme_ai_warning_count">
                    Door AI gelezen: <field name="vme_ai_warning_count" class="d-inline"/> veld(en) om na te kijken.
                    Zie het tabblad "AI-lezing".
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="vme_ai" string="AI-lezing" invisible="not vme_ai_state">
                    <group>
                        <group>
                            <field name="vme_ai_state" readonly="1"/>
                            <field name="vme_ai_model" readonly="1" invisible="not vme_ai_model"/>
                            <field name="vme_ai_iban" readonly="1" invisible="not vme_ai_iban"/>
                        </group>
                        <group invisible="not vme_ai_reviewed_by_id">
                            <field name="vme_ai_reviewed_by_id" readonly="1"/>
                            <field name="vme_ai_reviewed_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="vme_ai_check_ids" readonly="1">
                        <list decoration-danger="status == 'danger'" decoration-warning="status == 'warning'"
                              decoration-muted="status == 'ok' and not value">
                            <field name="name"/>
                            <field name="value"/>
                            <field name="confidence" widget="badge"
                                   decoration-success="confidence == 'high'" decoration-warning="confidence == 'medium'"
                                   decoration-danger="confidence == 'low'"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'ok'" decoration-warning="status == 'warning'"
                                   decoration-danger="status == 'danger'"/>
                            <field name="message"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_vme_ai" model="ir.ui.view">
        <field name="name">account.move.search.vme.ai</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="vme_ai_to_read" string="Te lezen door AI" domain="[('vme_ai_state', '=', 'to_read')]"/>
                <filter name="vme_ai_read" string="Gelezen door AI" domain="[('vme_ai_state', '=', 'read')]"/>
            </xpath>
        </field>
    </record>
</odoo>
