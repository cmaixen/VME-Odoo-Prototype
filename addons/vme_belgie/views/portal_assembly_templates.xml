<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Digital and hybrid assembly in the owner portal (step 24). -->
    <template id="portal_breadcrumbs_vme_assembly" inherit_id="vme_belgie.portal_breadcrumbs_vme" priority="41">
        <xpath expr="//li[@t-if=&quot;page_name == 'vme_address'&quot;]" position="after">
            <li t-if="page_name == 'vme_assembly'" class="breadcrumb-item">
                <a href="/my/vme">Mijn mede-eigendom</a>
            </li>
            <li t-if="page_name == 'vme_assembly'" class="breadcrumb-item">
                <a t-attf-href="/my/vme/#{vme.id}" t-out="vme.name"/>
            </li>
            <li t-if="page_name == 'vme_assembly'" class="breadcrumb-item">Algemene vergadering</li>
        </xpath>
    </template>

    <template id="portal_my_vme_detail_assembly" inherit_id="vme_belgie.portal_my_vme_detail" priority="41">
        <xpath expr="//h4[text()='Volgende algemene vergadering']/following-sibling::div[1]/div[hasclass('card-body')]" position="inside">
            <t t-if="assembly and assembly.state == 'confirmed' and (assembly.meeting_mode != 'in_person' or assembly.item_ids.filtered('allow_advance_vote'))">
                <a class="btn btn-primary mt-3" t-attf-href="/my/vme/assembly/#{assembly.id}">
                    <t t-if="assembly.meeting_mode != 'in_person'">Online deelnemen en stemmen</t>
                    <t t-else="">Schriftelijk stemmen</t>
                </a>
            </t>
        </xpath>
        <xpath expr="//h4[text()='Volgende algemene vergadering']" position="before">
            <div t-if="assemblies_to_sign" class="alert alert-warning">
                <strong>Notulen te ondertekenen:</strong>
                <t t-foreach="assemblies_to_sign" t-as="to_sign">
                    <a class="ms-2" t-attf-href="/my/vme/assembly/#{to_sign.id}#ondertekenen" t-out="to_sign.name"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_my_vme_assembly" name="Algemene vergadering in het portaal">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <h3 class="mt-3" t-out="assembly.name"/>
            <p class="text-muted">
                <span t-field="assembly.datetime_start" t-options="{'tz': 'Europe/Brussels', 'format': 'EEEE d MMMM yyyy \'om\' HH:mm'}"/>
                <t t-if="assembly.slot_id.location_type == 'room'"> · <t t-out="assembly.slot_id.room_id.name"/></t>
                · <span t-field="assembly.meeting_mode"/>
                <span t-if="assembly.state == 'held'" class="badge text-bg-secondary ms-2">Gehouden</span>
            </p>
            <div t-if="message" class="alert alert-success" role="status" t-out="message"/>
            <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>

            <!-- Attendance -->
            <div class="card mb-4" t-if="assembly.state == 'confirmed'">
                <div class="card-body">
                    <h5 class="card-title">Aanwezigheid</h5>
                    <t t-if="attendee and attendee.attendance == 'represented'">
                        <p class="mb-0">U hebt volmacht gegeven aan <strong t-out="attendee.proxy_holder_id.name"/>.
                            Die stemt voor u. Wilt u toch zelf deelnemen, neem dan contact op met de syndicus.</p>
                    </t>
                    <t t-elif="attendee and attendee.attendance == 'present' and attendee.attendance_mode == 'online'">
                        <p>U bent online aanwezig sinds <span t-field="attendee.checked_in_at" t-options="{'tz': 'Europe/Brussels', 'format': 'HH:mm'}"/>.</p>
                        <a t-if="assembly.video_url" class="btn btn-success" t-att-href="assembly.video_url" target="_blank" rel="noopener">Naar de videovergadering</a>
                    </t>
                    <t t-elif="assembly.meeting_mode == 'in_person'">
                        <p class="mb-0">Deze vergadering vindt in de zaal plaats. Over de punten hieronder kunt u vooraf schriftelijk stemmen.</p>
                    </t>
                    <t t-elif="assembly.online_open">
                        <form t-attf-action="/my/vme/assembly/#{assembly.id}/checkin" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <p>Het online onthaal is open. Meld u aan om mee te tellen voor het quorum en te stemmen.</p>
                            <button type="submit" class="btn btn-primary">Ik ben aanwezig (online)</button>
                        </form>
                    </t>
                    <t t-else="">
                        <p class="mb-0">Het online onthaal opent bij de start van de vergadering.
                            <a t-attf-href="/my/vme/assembly/#{assembly.id}">Vernieuwen</a></p>
                    </t>
                    <p t-if="represented" class="mt-3 mb-0">
                        U stemt ook voor wie u een volmacht gaf:
                        <t t-foreach="represented" t-as="proxy">
                            <span class="badge text-bg-light"><t t-out="proxy.partner_id.name"/> (<t t-out="proxy.lot_names"/>, <t t-out="'%g' % proxy.shares"/>)</span>
                        </t>
                    </p>
                </div>
            </div>

            <!-- Agenda and votes -->
            <h4>Agenda <a t-if="assembly.state == 'confirmed'" class="btn btn-sm btn-light ms-2" t-attf-href="/my/vme/assembly/#{assembly.id}">Vernieuwen</a></h4>
            <div t-foreach="assembly.item_ids.sorted('sequence')" t-as="item" class="card mb-3" t-att-id="'punt-%s' % item.id">
                <div class="card-body">
                    <h6 class="card-title"><t t-out="item.sequence"/>. <t t-out="item.name"/></h6>
                    <div t-if="item.description" class="small text-muted mb-2" t-out="item.description"/>
                    <t t-set="rights" t-value="item_rights[item.id][0]"/>
                    <t t-set="source" t-value="item_rights[item.id][1]"/>
                    <t t-if="item.majority == 'none'">
                        <span class="text-muted small">Geen stemming.</span>
                    </t>
                    <t t-elif="item.voting_state == 'closed' or assembly.state == 'held'">
                        <p class="mb-0">
                            Voor <strong t-out="'%g' % item.votes_for"/>, tegen <strong t-out="'%g' % item.votes_against"/>,
                            onthouding <t t-out="'%g' % item.votes_abstain"/> (vereist: <span t-field="item.majority"/>).
                            <span t-attf-class="badge ms-2 #{'text-bg-success' if item.outcome == 'adopted' else 'text-bg-danger' if item.outcome in ('rejected', 'no_quorum') else 'text-bg-secondary'}" t-field="item.outcome"/>
                        </p>
                    </t>
                    <t t-else="">
                        <div class="small text-muted mb-2">
                            Vereiste meerderheid: <span t-field="item.majority"/>.
                            <span t-if="item.voting_state == 'open'" class="badge text-bg-warning">Stemming open</span>
                            <span t-elif="source == 'written'" class="badge text-bg-info">Schriftelijk vooraf</span>
                            <span t-else="" class="badge text-bg-light">Stemming nog niet open</span>
                        </div>
                        <t t-set="open_rights" t-value="rights.filtered(lambda a: (item.id, a.id) not in votes)"/>
                        <t t-set="voted_mine" t-value="mine.filtered(lambda a: (item.id, a.id) in votes)"/>
                        <ul t-if="voted_mine" class="list-unstyled mb-2">
                            <li t-foreach="voted_mine" t-as="voted">
                                <t t-set="vote" t-value="votes[(item.id, voted.id)]"/>
                                ✓ <t t-out="voted.partner_id.name"/>: <strong t-field="vote.vote"/>
                                <span class="small text-muted">(<span t-field="vote.source"/>, <span t-field="vote.cast_at" t-options="{'tz': 'Europe/Brussels', 'format': 'd/MM HH:mm'}"/>)</span>
                            </li>
                        </ul>
                        <form t-if="open_rights" t-attf-action="/my/vme/assembly/#{assembly.id}/vote" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="item_id" t-att-value="item.id"/>
                            <table class="table table-sm align-middle mb-2">
                                <tbody>
                                    <tr t-foreach="open_rights" t-as="right">
                                        <td>
                                            <t t-out="right.partner_id.name"/>
                                            <span t-if="right.attendance == 'represented'" class="badge text-bg-light">volmacht</span>
                                            <div class="small text-muted"><t t-out="right.lot_names"/> · <t t-out="'%g' % right.shares"/> quotiteiten</div>
                                        </td>
                                        <td t-foreach="[('for', 'Voor'), ('against', 'Tegen'), ('abstain', 'Onthouding')]" t-as="choice" class="text-nowrap">
                                            <label class="form-check-label">
                                                <input class="form-check-input me-1" type="radio" required="required"
                                                       t-att-name="'vote_%s' % right.id" t-att-value="choice[0]"/>
                                                <t t-out="choice[1]"/>
                                            </label>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <button type="submit" class="btn btn-primary btn-sm">Stem uitbrengen</button>
                            <span class="small text-muted ms-2">Een uitgebrachte stem is definitief.</span>
                        </form>
                        <p t-if="not rights and item.voting_state == 'open'" class="small text-muted mb-0">
                            Meld u eerst online aan om te stemmen.</p>
                    </t>
                </div>
            </div>

            <!-- Signing the minutes -->
            <div t-if="signature" class="card mb-4" id="ondertekenen">
                <div class="card-body">
                    <h5 class="card-title">Notulen ondertekenen</h5>
                    <p>
                        <a t-attf-href="/my/vme/assembly/#{assembly.id}/minutes" target="_blank">Notulen (PDF) openen</a>
                        <br/><span class="small text-muted">SHA-256: <code t-out="assembly.minutes_sha256"/></span>
                    </p>
                    <t t-if="signature.state == 'signed'">
                        <p class="mb-0 text-success">U ondertekende deze notulen als <span t-field="signature.role"/> op
                            <span t-field="signature.signed_at" t-options="{'tz': 'Europe/Brussels'}"/>.</p>
                    </t>
                    <form t-else="" t-attf-action="/my/vme/assembly/#{assembly.id}/sign" method="post" style="max-width: 32rem;">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="signature_id" t-att-value="signature.id"/>
                        <p>U ondertekent als <strong t-field="signature.role"/>. We bewaren uw naam, het tijdstip,
                            uw IP-adres en de vingerafdruk (SHA-256) van de PDF.</p>
                        <label class="form-label" for="signed_name">Uw naam</label>
                        <input class="form-control mb-2" id="signed_name" name="signed_name" required="required"
                               t-att-placeholder="signature.partner_id.name"/>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="agree" name="agree" required="required"/>
                            <label class="form-check-label" for="agree">Ik heb de notulen gelezen en onderteken ze.</label>
                        </div>
                        <button type="submit" class="btn btn-primary">Ondertekenen</button>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
