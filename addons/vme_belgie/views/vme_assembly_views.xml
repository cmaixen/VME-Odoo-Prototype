<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Assembly period and convocation term on the VME form -->
    <record id="vme_association_view_form_assembly" model="ir.ui.view">
        <field name="name">vme.association.form.assembly</field>
        <field name="model">vme.association</field>
        <field name="inherit_id" ref="vme_association_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_assemblies" type="object" class="oe_stat_button" icon="fa-calendar">
                    <div class="o_stat_info"><span class="o_stat_text">AV's</span></div>
                </button>
            </xpath>
            <xpath expr="//field[@name='reserve_capital_bank_id']/.." position="after">
                <group string="Algemene vergadering">
                    <label for="assembly_period_month" string="Periode gewone AV"/>
                    <div class="d-flex gap-2 align-items-baseline">
                        <span>vanaf</span>
                        <field name="assembly_period_day" nolabel="1" style="max-width: 3rem"/>
                        <field name="assembly_period_month" nolabel="1" placeholder="maand" style="max-width: 9rem"/>
                        <span class="text-muted text-nowrap" invisible="not assembly_period_display">(15 dagen: <field name="assembly_period_display" class="oe_inline" nolabel="1"/>)</span>
                    </div>
                    <field name="convocation_days"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Rooms -->
    <record id="vme_assembly_room_view_list" model="ir.ui.view">
        <field name="name">vme.assembly.room.list</field>
        <field name="model">vme.assembly.room</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="address"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <record id="vme_assembly_room_action" model="ir.actions.act_window">
        <field name="name">Vergaderzalen</field>
        <field name="res_model">vme.assembly.room</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Blocks -->
    <record id="vme_assembly_slot_view_list" model="ir.ui.view">
        <field name="name">vme.assembly.slot.list</field>
        <field name="model">vme.assembly.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="time_start" widget="float_time"/>
                <field name="location_type"/>
                <field name="room_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="max_assemblies"/>
                <field name="assembly_count"/>
                <field name="free_count" decoration-success="free_count > 0" decoration-muted="free_count == 0"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="vme_assembly_slot_view_form" model="ir.ui.view">
        <field name="name">vme.assembly.slot.form</field>
        <field name="model">vme.assembly.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Wanneer">
                            <field name="date"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="assembly_duration" widget="float_time"/>
                            <field name="max_assemblies"/>
                        </group>
                        <group string="Waar en wie">
                            <field name="location_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="room_id" invisible="location_type != 'room'" required="location_type == 'room'"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <field name="assembly_ids" readonly="1">
                        <list>
                            <field name="association_id"/>
                            <field name="datetime_start"/>
                            <field name="state" widget="badge" decoration-info="state == 'proposed'" decoration-success="state == 'confirmed'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vme_assembly_slot_view_search" model="ir.ui.view">
        <field name="name">vme.assembly.slot.search</field>
        <field name="model">vme.assembly.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_id"/>
                <field name="user_id"/>
                <filter name="future" string="Komend" domain="[('date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="online" string="Online" domain="[('location_type', '=', 'online')]"/>
                <group>
                    <filter name="group_user" string="Medewerker" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="Maand" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_assembly_slot_action" model="ir.actions.act_window">
        <field name="name">Blokken</field>
        <field name="res_model">vme.assembly.slot</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_future': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen blokken</p>
            <p>Een blok is een avond waarop een medewerker in een zaal of online één of meer AV's kan leiden.</p>
        </field>
    </record>

    <!-- Assemblies -->
    <record id="vme_assembly_view_list" model="ir.ui.view">
        <field name="name">vme.assembly.list</field>
        <field name="model">vme.assembly</field>
        <field name="arch" type="xml">
            <list decoration-danger="warning_level == 'danger'" decoration-warning="warning_level == 'warning'">
                <header>
                    <button name="action_confirm" type="object" string="Bevestigen" class="btn-primary"/>
                </header>
                <field name="association_id"/>
                <field name="year" options="{'enable_formatting': false}" optional="hide"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="slot_id" options="{'no_create': True}" optional="hide"/>
                <field name="datetime_start" optional="show"/>
                <field name="slot_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="convocation_deadline"/>
                <field name="convocation_sent_date" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'proposed'"
                       decoration-success="state in ('confirmed', 'held')" decoration-muted="state == 'cancelled'"/>
                <field name="warning_level" column_invisible="1"/>
                <field name="warning"/>
            </list>
        </field>
    </record>

    <record id="vme_assembly_view_form" model="ir.ui.view">
        <field name="name">vme.assembly.form</field>
        <field name="model">vme.assembly</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Bevestigen" class="btn-primary" invisible="state != 'proposed'"/>
                    <button name="action_mark_convocation_sent" type="object" string="Oproeping verstuurd"
                            invisible="state != 'confirmed' or convocation_sent_date"/>
                    <button name="action_mark_held" type="object" string="Gehouden" invisible="state != 'confirmed'"/>
                    <button name="action_reset" type="object" string="Opnieuw plannen" invisible="state not in ('proposed', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Annuleren" invisible="state in ('held', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,proposed,confirmed,held"/>
                </header>
                <field name="warning_level" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="warning_level != 'danger'">
                    <field name="warning"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="warning_level != 'warning'">
                    <field name="warning"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_calendar_event" type="object" class="oe_stat_button" icon="fa-calendar"
                                invisible="not calendar_event_id">
                            <div class="o_stat_info"><span class="o_stat_text">Agenda</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Periode">
                            <field name="association_id" readonly="id"/>
                            <field name="year" options="{'enable_formatting': false}" readonly="id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group string="Planning">
                            <field name="slot_id" options="{'no_create': True}" readonly="state in ('held', 'cancelled')"/>
                            <field name="datetime_start"/>
                            <field name="location"/>
                            <field name="slot_user_id"/>
                            <field name="calendar_event_id" invisible="1"/>
                        </group>
                        <group string="Oproeping">
                            <field name="convocation_days"/>
                            <field name="convocation_deadline"/>
                            <field name="convocation_sent_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vme_assembly_view_calendar" model="ir.ui.view">
        <field name="name">vme.assembly.calendar</field>
        <field name="model">vme.assembly</field>
        <field name="arch" type="xml">
            <calendar date_start="datetime_start" date_stop="datetime_end" color="slot_user_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="association_id"/>
                <field name="location"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="vme_assembly_view_search" model="ir.ui.view">
        <field name="name">vme.assembly.search</field>
        <field name="model">vme.assembly</field>
        <field name="arch" type="xml">
            <search>
                <field name="association_id"/>
                <field name="year"/>
                <filter name="to_plan" string="Te plannen" domain="[('state', '=', 'draft')]"/>
                <filter name="proposed" string="Voorgesteld" domain="[('state', '=', 'proposed')]"/>
                <filter name="confirmed" string="Bevestigd" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="at_risk" string="Dreigt te laat" domain="[('warning_level', 'in', ['warning', 'danger'])]"/>
                <filter name="open" string="Nog niet gehouden" domain="[('state', 'not in', ['held', 'cancelled'])]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_year" string="Jaar" context="{'group_by': 'year'}"/>
                    <filter name="group_month" string="Maand" context="{'group_by': 'period_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_assembly_action" model="ir.actions.act_window">
        <field name="name">Algemene vergaderingen</field>
        <field name="res_model">vme.assembly</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen algemene vergaderingen</p>
            <p>Geef per VME de periode van de gewone AV in en open de AV-planner om een seizoen in te delen.</p>
        </field>
    </record>

    <!-- Planner wizard -->
    <record id="vme_assembly_planner_wizard_view_form" model="ir.ui.view">
        <field name="name">vme.assembly.planner.wizard.form</field>
        <field name="model">vme.assembly.planner.wizard</field>
        <field name="arch" type="xml">
            <form string="AV-planner">
                <p>
                    De planner maakt voor elke VME de gewone AV van het gekozen jaar aan en zet ze in een vrij blok
                    binnen haar periode van 15 dagen. Een zaal of medewerker wordt nooit dubbel geboekt, en een blok
                    wordt alleen gekozen als de oproeping nog op tijd kan vertrekken. Bevestigde AV's blijven staan.
                </p>
                <group>
                    <field name="year" options="{'enable_formatting': false}"/>
                    <field name="association_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="replan_proposed"/>
                </group>
                <footer>
                    <button name="action_propose" type="object" string="Indeling voorstellen" class="btn-primary"/>
                    <button string="Sluiten" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vme_assembly_planner_wizard_action" model="ir.actions.act_window">
        <field name="name">AV-planner</field>
        <field name="res_model">vme.assembly.planner.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_vme_assembly_root" name="Algemene vergaderingen" parent="menu_vme_root" sequence="50"/>
    <menuitem id="menu_vme_assembly" name="AV's" parent="menu_vme_assembly_root" action="vme_assembly_action" sequence="10"/>
    <menuitem id="menu_vme_assembly_planner" name="AV-planner" parent="menu_vme_assembly_root" action="vme_assembly_planner_wizard_action" sequence="20"/>
    <menuitem id="menu_vme_assembly_slot" name="Blokken" parent="menu_vme_assembly_root" action="vme_assembly_slot_action" sequence="30"/>
    <menuitem id="menu_vme_assembly_room" name="Vergaderzalen" parent="menu_vme_assembly_root" action="vme_assembly_room_action" sequence="40"/>
</odoo>
