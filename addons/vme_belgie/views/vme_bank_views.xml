<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_bank_line_view_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.vme.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Bankbewegingen" create="0" decoration-muted="vme_match_state in ('auto', 'manual') and not vme_follow_up"
                  decoration-warning="vme_match_state == 'suggested'" decoration-danger="vme_match_state == 'todo'">
                <field name="date"/>
                <field name="vme_association_id" string="VME"/>
                <field name="vme_bank_fund"/>
                <field name="partner_name" string="Van / aan"/>
                <field name="payment_ref" string="Mededeling"/>
                <field name="partner_id" string="Eigenaar of leverancier" optional="show"/>
                <field name="amount" sum="Totaal"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="vme_match_state" widget="badge"
                       decoration-success="vme_match_state in ('auto', 'manual')"
                       decoration-warning="vme_match_state == 'suggested'" decoration-danger="vme_match_state == 'todo'"/>
                <field name="vme_exception" optional="show"/>
                <field name="vme_days_late" optional="show"/>
                <field name="vme_candidate_move_ids" widget="many2many_tags" optional="show"/>
                <field name="vme_matched_move_ids" widget="many2many_tags" optional="hide"/>
                <field name="vme_match_note" optional="show"/>
                <field name="is_reconciled" column_invisible="1"/>
                <field name="vme_follow_up" column_invisible="1"/>
                <button name="action_vme_reconcile" type="object" string="Koppelen" icon="fa-link"
                        invisible="is_reconciled or not vme_candidate_move_ids"/>
            </list>
        </field>
    </record>

    <record id="vme_bank_line_view_form" model="ir.ui.view">
        <field name="name">account.bank.statement.line.vme.form</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Bankbeweging" create="0">
                <header>
                    <button name="action_vme_reconcile" type="object" string="Koppelen" class="btn-primary"
                            invisible="is_reconciled or not vme_candidate_move_ids"/>
                    <button name="action_vme_book_on_partner" type="object" string="Boeken op eigenaar of leverancier"
                            invisible="is_reconciled or not partner_id"
                            confirm="Het bedrag wordt zonder factuur op de rekening van deze eigenaar of leverancier geboekt (tegoed of schuld). Doorgaan?"/>
                    <button name="action_vme_rematch" type="object" string="Opnieuw zoeken" invisible="is_reconciled"/>
                    <button name="action_vme_undo" type="object" string="Koppeling ongedaan maken" invisible="not is_reconciled"/>
                    <field name="vme_match_state" widget="statusbar" statusbar_visible="todo,suggested,auto,manual"/>
                </header>
                <sheet>
                    <group>
                        <group string="Bankbeweging">
                            <field name="date" readonly="1"/>
                            <field name="vme_association_id" string="VME" readonly="1"/>
                            <field name="journal_id" string="Rekening" readonly="1"/>
                            <field name="vme_bank_fund" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="partner_name" string="Van / aan" readonly="1"/>
                            <field name="account_number" string="Rekening tegenpartij" readonly="1"/>
                            <field name="payment_ref" string="Mededeling" readonly="1"/>
                            <field name="vme_structured_reference" invisible="not vme_structured_reference"/>
                        </group>
                        <group string="Koppeling">
                            <field name="company_id" invisible="1"/>
                            <field name="is_reconciled" invisible="1"/>
                            <field name="partner_id" string="Eigenaar of leverancier" readonly="is_reconciled"
                                   options="{'no_create': True}"/>
                            <field name="vme_exception" readonly="1"/>
                            <field name="vme_days_late" invisible="not vme_days_late" readonly="1"/>
                            <field name="vme_match_note" readonly="1"/>
                            <field name="vme_matched_move_ids" widget="many2many_tags" invisible="not is_reconciled"/>
                        </group>
                    </group>
                    <separator string="Voorstel" invisible="is_reconciled"/>
                    <field name="vme_candidate_move_ids" invisible="is_reconciled" nolabel="1"
                           domain="[('company_id', '=', company_id), ('state', '=', 'posted'),
                                    ('move_type', 'in', ('out_invoice', 'in_invoice')),
                                    ('payment_state', 'not in', ('paid', 'in_payment', 'reversed'))]"
                           options="{'no_create': True}">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="payment_reference"/>
                            <field name="vme_fund"/>
                            <field name="amount_residual" string="Open"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vme_bank_line_view_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.vme.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search string="Bankbewegingen">
                <field name="payment_ref" string="Mededeling"/>
                <field name="partner_name" string="Van / aan"/>
                <field name="partner_id"/>
                <field name="vme_association_id" string="VME"/>
                <field name="amount"/>
                <filter name="follow_up" string="Op te volgen" domain="[('vme_follow_up', '=', True)]"/>
                <filter name="to_match" string="Nog te koppelen" domain="[('vme_match_state', 'in', ('todo', 'suggested'))]"/>
                <filter name="late" string="Te laat" domain="[('vme_days_late', '>', 0)]"/>
                <separator/>
                <filter name="incoming" string="Ontvangsten" domain="[('amount', '>', 0)]"/>
                <filter name="outgoing" string="Uitgaven" domain="[('amount', '&lt;', 0)]"/>
                <group>
                    <filter name="group_state" string="Koppeling" context="{'group_by': 'vme_match_state'}"/>
                    <filter name="group_exception" string="Uitzondering" context="{'group_by': 'vme_exception'}"/>
                    <filter name="group_vme" string="VME" context="{'group_by': 'vme_association_id'}"/>
                    <filter name="group_fund" string="Fondsrekening" context="{'group_by': 'vme_bank_fund'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_bank_line_action" model="ir.actions.act_window">
        <field name="name">Bankbewegingen</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vme_association_id', '!=', False)]</field>
        <field name="search_view_id" ref="vme_bank_line_view_search"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('vme_bank_line_view_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('vme_bank_line_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen bankbewegingen</p>
            <p>Lees een CODA- of CAMT.053-bestand van de bank in via Bank &gt; Bankafschriften inlezen.</p>
        </field>
    </record>

    <record id="vme_bank_line_follow_up_action" model="ir.actions.act_window">
        <field name="name">Op te volgen betalingen</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vme_association_id', '!=', False)]</field>
        <field name="context">{'search_default_follow_up': 1, 'search_default_group_state': 1}</field>
        <field name="search_view_id" ref="vme_bank_line_view_search"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('vme_bank_line_view_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('vme_bank_line_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Alles is gekoppeld</p>
            <p>Hier komen betalingen zonder of met een foute mededeling, en betalingen die te laat, te weinig of te veel zijn.</p>
        </field>
    </record>

    <record id="vme_bank_import_wizard_view_form" model="ir.ui.view">
        <field name="name">vme.bank.import.wizard.form</field>
        <field name="model">vme.bank.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Bankafschriften inlezen">
                <p>
                    Kies een CODA-bestand (.cod) of een CAMT.053-bestand (.xml) van de bank. Het rekeningnummer in het
                    bestand bepaalt de VME en het fonds; betalingen met een juiste gestructureerde mededeling worden
                    meteen gekoppeld.
                </p>
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Inlezen" class="btn-primary"/>
                    <button string="Annuleren" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vme_bank_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Bankafschriften inlezen</field>
        <field name="res_model">vme.bank.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_load_demo_bank_statements" model="ir.actions.server">
        <field name="name">Demobankafschriften inlezen</field>
        <field name="model_id" ref="model_vme_association"/>
        <field name="state">code</field>
        <field name="code">action = model._load_demo_bank_statements()</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <menuitem id="menu_vme_bank" name="Bank" parent="menu_vme_root" sequence="48" groups="account.group_account_invoice"/>
    <menuitem id="menu_vme_bank_import" name="Bankafschriften inlezen" parent="menu_vme_bank" action="vme_bank_import_wizard_action" sequence="10"/>
    <menuitem id="menu_vme_bank_follow_up" name="Op te volgen betalingen" parent="menu_vme_bank" action="vme_bank_line_follow_up_action" sequence="20"/>
    <menuitem id="menu_vme_bank_lines" name="Alle bankbewegingen" parent="menu_vme_bank" action="vme_bank_line_action" sequence="30"/>
    <menuitem id="menu_vme_load_demo_bank" name="Demobankafschriften inlezen" parent="menu_vme_configuration" action="action_load_demo_bank_statements" sequence="12"/>
</odoo>
