<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_contract_view_list" model="ir.ui.view">
        <field name="name">vme.contract.list</field>
        <field name="model">vme.contract</field>
        <field name="arch" type="xml">
            <list decoration-danger="notice_state == 'due_30'" decoration-warning="notice_state == 'due_60'"
                  decoration-muted="state == 'ended'">
                <field name="association_id"/>
                <field name="name"/>
                <field name="contract_type"/>
                <field name="partner_id"/>
                <field name="reference" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end"/>
                <field name="auto_renew" optional="show"/>
                <field name="notice_period_months" optional="show"/>
                <field name="notice_deadline"/>
                <field name="notice_state" widget="badge"
                       decoration-danger="notice_state == 'due_30'" decoration-warning="notice_state == 'due_60'"
                       decoration-info="notice_state == 'due_90'" decoration-success="notice_state == 'ok'"/>
                <field name="next_evaluation_date" optional="show"/>
                <field name="annual_amount" sum="Totaal" optional="show"/>
                <field name="distribution_key_id" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'running'"
                       decoration-warning="state == 'notice_given'" optional="show"/>
                <field name="responsible_user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="vme_contract_view_form" model="ir.ui.view">
        <field name="name">vme.contract.form</field>
        <field name="model">vme.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_give_notice" type="object" string="Opzeg geregistreerd" invisible="state != 'running'"
                            confirm="Registreer je dat de opzeg verstuurd is? Odoo verstuurt zelf niets."/>
                    <button name="action_end" type="object" string="Beëindigen" invisible="state == 'ended'"/>
                    <button name="action_reopen" type="object" string="Terug lopend" invisible="state == 'running'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_bills" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not id">
                            <field name="billed_this_year" widget="statinfo" string="Dit jaar"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Beëindigd" bg_color="text-bg-secondary" invisible="state != 'ended'"/>
                    <widget name="web_ribbon" title="Opgezegd" bg_color="text-bg-warning" invisible="state != 'notice_given'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="bv. Schoonmaak gemene delen"/></h1>
                    </div>
                    <group>
                        <group string="Contract">
                            <field name="association_id"/>
                            <field name="contract_type"/>
                            <field name="partner_id"/>
                            <field name="reference"/>
                            <field name="installation_id" invisible="contract_type not in ('maintenance', 'elevator')"/>
                            <field name="responsible_user_id" widget="many2one_avatar_user"/>
                            <field name="annual_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Looptijd en opzeg">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="auto_renew"/>
                            <field name="renewal_months" invisible="not auto_renew"/>
                            <field name="notice_period_months"/>
                            <field name="notice_deadline"/>
                            <field name="notice_state" widget="badge" invisible="state != 'running'"
                                   decoration-danger="notice_state == 'due_30'" decoration-warning="notice_state == 'due_60'"
                                   decoration-info="notice_state == 'due_90'" decoration-success="notice_state == 'ok'"/>
                            <field name="notice_given_date" invisible="not notice_given_date"/>
                        </group>
                        <group string="Kosten verdelen">
                            <field name="distribution_rule_id" invisible="not distribution_rule_id"/>
                            <field name="distribution_key_id" invisible="not distribution_rule_id"/>
                            <field name="distribution_account_id" invisible="not distribution_rule_id"/>
                            <div colspan="2" class="text-warning" invisible="distribution_rule_id or not partner_id">
                                Geen verdeelregel voor deze leverancier: zijn facturen worden niet automatisch verdeeld.
                                Maak er een aan onder VME > Configuratie > Verdeelregels.
                            </div>
                        </group>
                        <group string="Evaluatie">
                            <field name="last_evaluation_date"/>
                            <field name="next_evaluation_date"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="contract_type != 'staff'">
                        De loonkosten van de conciërge komen als factuur van het sociaal secretariaat binnen en worden
                        via de verdeelregel van die leverancier over de eigenaars verdeeld. De opzegtermijn van de
                        arbeidsovereenkomst zelf berekent Odoo niet.
                    </div>
                    <notebook>
                        <page string="Evaluaties" name="evaluations">
                            <field name="evaluation_ids" context="{'default_contract_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="rating"/>
                                    <field name="outcome"/>
                                    <field name="assembly_id" optional="show"/>
                                    <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                                    <field name="note"/>
                                    <field name="association_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notities" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vme_contract_view_calendar" model="ir.ui.view">
        <field name="name">vme.contract.calendar</field>
        <field name="model">vme.contract</field>
        <field name="arch" type="xml">
            <calendar string="Opzegtermijnen" date_start="notice_deadline" color="contract_type" mode="month" quick_create="0">
                <field name="association_id"/>
                <field name="contract_type" filters="1"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <record id="vme_contract_view_search" model="ir.ui.view">
        <field name="name">vme.contract.search</field>
        <field name="model">vme.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="association_id"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="running" string="Lopend" domain="[('state', '=', 'running')]"/>
                <filter name="notice_given" string="Opgezegd" domain="[('state', '=', 'notice_given')]"/>
                <separator/>
                <filter name="notice_30" string="Opzeggen binnen 30 dagen"
                        domain="[('state', '=', 'running'), ('notice_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')), ('notice_deadline', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="notice_60" string="Opzeggen binnen 60 dagen"
                        domain="[('state', '=', 'running'), ('notice_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')), ('notice_deadline', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter name="evaluation_due" string="Evaluatie binnen 30 dagen"
                        domain="[('state', '=', 'running'), ('next_evaluation_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="archived" string="Gearchiveerd" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                    <filter name="group_type" string="Soort" context="{'group_by': 'contract_type'}"/>
                    <filter name="group_partner" string="Leverancier" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_contract_action" model="ir.actions.act_window">
        <field name="name">Contracten</field>
        <field name="res_model">vme.contract</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_running': 1, 'search_default_group_association': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen contracten</p>
            <p>Voeg per VME de lopende contracten toe: onderhoud, schoonmaak, verzekering, energie, lift en conciërge.
               Odoo maakt een taak 60 dagen vóór elke opzegtermijn.</p>
        </field>
    </record>

    <record id="vme_contract_evaluation_view_list" model="ir.ui.view">
        <field name="name">vme.contract.evaluation.list</field>
        <field name="model">vme.contract.evaluation</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="association_id"/>
                <field name="contract_id"/>
                <field name="date"/>
                <field name="rating" widget="badge" decoration-success="rating == 'good'" decoration-danger="rating == 'insufficient'"/>
                <field name="outcome"/>
                <field name="assembly_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="vme_contract_evaluation_view_search" model="ir.ui.view">
        <field name="name">vme.contract.evaluation.search</field>
        <field name="model">vme.contract.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="association_id"/>
                <filter name="not_continue" string="Niet verderzetten" domain="[('outcome', '!=', 'continue')]"/>
                <group>
                    <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                    <filter name="group_year" string="Jaar" context="{'group_by': 'date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_contract_evaluation_action" model="ir.actions.act_window">
        <field name="name">Evaluaties van contracten</field>
        <field name="res_model">vme.contract.evaluation</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_association': 1}</field>
    </record>

    <!-- Contracts page on the VME form, as an inherited view so the base form stays untouched. -->
    <record id="vme_association_view_form_contracts" model="ir.ui.view">
        <field name="name">vme.association.form.contracts</field>
        <field name="model">vme.association</field>
        <field name="inherit_id" ref="vme_association_view_form"/>
        <field name="arch" type="xml">
            <page name="installations" position="after">
                <page string="Contracten" name="contracts">
                    <field name="contract_ids" readonly="not id" context="{'default_association_id': id}">
                        <list decoration-danger="notice_state == 'due_30'" decoration-warning="notice_state == 'due_60'"
                              decoration-muted="state == 'ended'">
                            <field name="name"/>
                            <field name="contract_type"/>
                            <field name="partner_id"/>
                            <field name="date_end"/>
                            <field name="notice_deadline"/>
                            <field name="notice_state" widget="badge"
                                   decoration-danger="notice_state == 'due_30'" decoration-warning="notice_state == 'due_60'"
                                   decoration-info="notice_state == 'due_90'" decoration-success="notice_state == 'ok'"/>
                            <field name="distribution_key_id" optional="show"/>
                            <field name="state" optional="show"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <menuitem id="menu_vme_contracts" name="Contracten" parent="menu_vme_root" sequence="57"/>
    <menuitem id="menu_vme_contract" name="Lopende contracten" parent="menu_vme_contracts"
              action="vme_contract_action" sequence="10"/>
    <menuitem id="menu_vme_contract_evaluation" name="Evaluaties" parent="menu_vme_contracts"
              action="vme_contract_evaluation_action" sequence="20"/>

    <record id="ir_cron_vme_contract_activities" model="ir.cron">
        <field name="name">VME: verlengingen en taken vóór opzegtermijnen en evaluaties van contracten</field>
        <field name="model_id" ref="model_vme_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_schedule_contract_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
