<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The auditor reads the cycle of his VMEs and changes nothing (see vme_council_security.xml). -->
    <record id="rule_auditor_read_cycle_step" model="ir.rule">
        <field name="name">Commissaris: vme.cycle.step van zijn VME's</field>
        <field name="model_id" ref="model_vme_cycle_step"/>
        <field name="groups" eval="[Command.link(ref('group_vme_auditor'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_auditor_no_write_cycle_step" model="ir.rule">
        <field name="name">Commissaris: vme.cycle.step alleen lezen</field>
        <field name="model_id" ref="model_vme_cycle_step"/>
        <field name="groups" eval="[Command.link(ref('group_vme_auditor'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="vme_cycle_step_view_list" model="ir.ui.view">
        <field name="name">vme.cycle.step.list</field>
        <field name="model">vme.cycle.step</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="is_late" decoration-info="state == 'ready' and not is_late"
                  decoration-muted="state in ('done', 'skipped')">
                <field name="association_id"/>
                <field name="year" optional="hide"/>
                <field name="name"/>
                <field name="date_ready" optional="show"/>
                <field name="date_deadline"/>
                <field name="is_late" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'ready'" decoration-success="state == 'done'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <button name="action_prepare_now" type="object" string="Nu klaarzetten" icon="fa-play"
                        invisible="state != 'pending'"/>
                <button name="action_open_record" type="object" string="Open" icon="fa-external-link"
                        invisible="not res_id"/>
            </list>
        </field>
    </record>

    <record id="vme_cycle_step_view_form" model="ir.ui.view">
        <field name="name">vme.cycle.step.form</field>
        <field name="model">vme.cycle.step</field>
        <field name="arch" type="xml">
            <form string="Stap in de jaarcyclus" create="0">
                <header>
                    <button name="action_prepare_now" type="object" string="Nu klaarzetten" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_open_record" type="object" string="Open concept" class="btn-primary"
                            invisible="not res_id"/>
                    <button name="action_mark_done" type="object" string="Afgerond" invisible="state in ('done', 'skipped')"/>
                    <button name="action_skip" type="object" string="Niet van toepassing" invisible="state in ('done', 'skipped')"/>
                    <button name="action_reopen" type="object" string="Heropenen" invisible="state not in ('done', 'skipped')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,ready,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div><field name="association_id" readonly="1"/></div>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not is_late">
                        Deze stap is te laat: de uiterste datum is voorbij.
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="year" readonly="1"/>
                            <field name="date_ready" readonly="1"/>
                            <field name="date_deadline" readonly="1"/>
                            <field name="is_late" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="prepared_date"/>
                            <field name="done_date"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Wat staat er klaar, of wat moet eerst opgelost worden?"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vme_cycle_step_view_calendar" model="ir.ui.view">
        <field name="name">vme.cycle.step.calendar</field>
        <field name="model">vme.cycle.step</field>
        <field name="arch" type="xml">
            <calendar date_start="date_deadline" color="association_id" mode="month" quick_create="0" create="0">
                <field name="association_id" filters="1"/>
                <field name="name"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="vme_cycle_step_view_search" model="ir.ui.view">
        <field name="name">vme.cycle.step.search</field>
        <field name="model">vme.cycle.step</field>
        <field name="arch" type="xml">
            <search>
                <field name="association_id"/>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('pending', 'ready'))]"/>
                <filter name="late" string="Te laat" domain="[('is_late', '=', True)]"/>
                <filter name="ready" string="Klaargezet" domain="[('state', '=', 'ready')]"/>
                <filter name="this_month" string="Deze maand"
                        domain="[('date_deadline', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date_deadline', '&lt;', (context_today() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="mine" string="Mijn stappen" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="done" string="Afgerond" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                    <filter name="group_month" string="Maand" context="{'group_by': 'date_deadline:month'}"/>
                    <filter name="group_code" string="Soort" context="{'group_by': 'code'}"/>
                    <filter name="group_year" string="Cyclusjaar" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_cycle_step_action" model="ir.actions.act_window">
        <field name="name">Jaarcyclus</field>
        <field name="res_model">vme.cycle.step</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_association': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen stappen</p>
            <p>Vul op een VME "Jaarcyclus vanaf" in. Odoo zet dan elke stap van het jaar op tijd klaar als concept of taak.</p>
        </field>
    </record>

    <record id="ir_cron_vme_cycle" model="ir.cron">
        <field name="name">VME: jaarcyclus klaarzetten</field>
        <field name="model_id" ref="model_vme_cycle_step"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_cycle()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <menuitem id="menu_vme_cycle" name="Jaarcyclus" parent="menu_vme_root" action="vme_cycle_step_action" sequence="7"/>

    <!-- Tab on the VME form -->
    <record id="vme_association_view_form_inherit_cycle" model="ir.ui.view">
        <field name="name">vme.association.form.cycle</field>
        <field name="model">vme.association</field>
        <field name="inherit_id" ref="vme_association_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_cycle" type="object" string="Jaarcyclus" invisible="not id"/>
            </xpath>
            <xpath expr="//page[@name='budgets']" position="after">
                <page string="Jaarcyclus" name="cycle">
                    <group>
                        <group>
                            <field name="cycle_start_date"/>
                            <field name="cycle_user_id"/>
                        </group>
                        <group>
                            <field name="cycle_current_step"/>
                            <field name="cycle_late_count"/>
                        </group>
                    </group>
                    <button name="action_cycle_sync" type="object" string="Kalender bijwerken en klaarzetten"
                            class="btn-secondary" invisible="not cycle_start_date"/>
                    <field name="cycle_step_ids" readonly="1" domain="[('state', 'in', ('pending', 'ready'))]">
                        <list decoration-danger="is_late" decoration-muted="state in ('done', 'skipped')">
                            <field name="name"/>
                            <field name="date_ready"/>
                            <field name="date_deadline"/>
                            <field name="is_late"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Portfolio (step 22): next step and late steps per VME -->
    <record id="vme_association_view_list_portfolio_cycle" model="ir.ui.view">
        <field name="name">vme.association.list.portfolio.cycle</field>
        <field name="model">vme.association</field>
        <field name="inherit_id" ref="vme_association_view_list_portfolio"/>
        <field name="arch" type="xml">
            <field name="signal_inspection" position="after">
                <field name="signal_cycle" widget="boolean_toggle" readonly="1" string="Jaarcyclus"/>
                <field name="cycle_current_step" optional="show"/>
            </field>
        </field>
    </record>

    <record id="vme_association_view_search_portfolio_cycle" model="ir.ui.view">
        <field name="name">vme.association.search.portfolio.cycle</field>
        <field name="model">vme.association</field>
        <field name="inherit_id" ref="vme_association_view_search_portfolio"/>
        <field name="arch" type="xml">
            <filter name="signal_inspection" position="after">
                <filter name="signal_cycle" string="Stap in de jaarcyclus te laat" domain="[('signal_cycle', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="vme_association_view_kanban_card_cycle" model="ir.ui.view">
        <field name="name">vme.association.kanban.card.cycle</field>
        <field name="model">vme.association</field>
        <field name="inherit_id" ref="vme_association_view_kanban_card"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('mt-2')][hasclass('small')]" position="inside">
                <div t-if="record.cycle_current_step.raw_value">Jaarcyclus: <field name="cycle_current_step"/></div>
            </xpath>
        </field>
    </record>
</odoo>
