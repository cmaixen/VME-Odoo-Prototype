<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_key_view_list" model="ir.ui.view">
        <field name="name">vme.key.list</field>
        <field name="model">vme.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="association_id"/>
                <field name="name"/>
                <field name="key_type"/>
                <field name="total_shares"/>
                <field name="shares_sum"/>
                <field name="is_balanced"/>
            </list>
        </field>
    </record>

    <record id="vme_key_view_form" model="ir.ui.view">
        <field name="name">vme.key.form</field>
        <field name="model">vme.key</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning mb-0" role="alert" invisible="is_balanced or not line_ids">
                    De quotiteiten tellen op tot <field name="shares_sum" class="fw-bold"/>,
                    het totaal is <field name="total_shares" readonly="1" class="fw-bold"/>.
                    Verschil: <field name="shares_difference" class="fw-bold"/>. Opslaan lukt pas als dit 0 is.
                </div>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="bv. Algemene sleutel"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="association_id"/>
                            <field name="key_type"/>
                        </group>
                        <group>
                            <field name="total_shares"/>
                            <field name="is_balanced"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="not association_id">
                        <list editable="bottom">
                            <field name="association_id" column_invisible="1"/>
                            <field name="lot_id"/>
                            <field name="shares" sum="Totaal"/>
                            <field name="percentage" sum="Totaal"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vme_key_view_search" model="ir.ui.view">
        <field name="name">vme.key.search</field>
        <field name="model">vme.key</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="association_id"/>
                <group>
                    <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_key_action" model="ir.actions.act_window">
        <field name="name">Verdeelsleutels</field>
        <field name="res_model">vme.key</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_association': 1}</field>
    </record>
</odoo>
