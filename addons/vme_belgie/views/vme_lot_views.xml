<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_lot_view_list" model="ir.ui.view">
        <field name="name">vme.lot.list</field>
        <field name="model">vme.lot</field>
        <field name="arch" type="xml">
            <list>
                <field name="association_id"/>
                <field name="name"/>
                <field name="lot_type"/>
                <field name="floor"/>
                <field name="current_owner_id"/>
            </list>
        </field>
    </record>

    <record id="vme_lot_view_form" model="ir.ui.view">
        <field name="name">vme.lot.form</field>
        <field name="model">vme.lot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="bv. A1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="association_id"/>
                            <field name="lot_type"/>
                            <field name="floor"/>
                        </group>
                        <group>
                            <field name="current_owner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Eigendommen" name="ownerships">
                            <field name="ownership_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vme_lot_view_search" model="ir.ui.view">
        <field name="name">vme.lot.search</field>
        <field name="model">vme.lot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="association_id"/>
                <field name="ownership_ids" string="Eigenaar" filter_domain="[('ownership_ids.partner_id', 'ilike', self)]"/>
                <filter name="apartments" string="Appartementen" domain="[('lot_type', '=', 'apartment')]"/>
                <filter name="garages" string="Garages" domain="[('lot_type', '=', 'garage')]"/>
                <group>
                    <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'lot_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_lot_action" model="ir.actions.act_window">
        <field name="name">Kavels</field>
        <field name="res_model">vme.lot</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_association': 1}</field>
    </record>
</odoo>
