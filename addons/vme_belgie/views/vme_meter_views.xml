<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_meter_view_list" model="ir.ui.view">
        <field name="name">vme.meter.list</field>
        <field name="model">vme.meter</field>
        <field name="arch" type="xml">
            <list>
                <field name="association_id"/>
                <field name="lot_id"/>
                <field name="name"/>
                <field name="meter_type"/>
                <field name="location" optional="show"/>
                <field name="factor"/>
                <field name="last_reading_date"/>
                <field name="last_reading_value"/>
                <field name="unit"/>
            </list>
        </field>
    </record>

    <record id="vme_meter_view_form" model="ir.ui.view">
        <field name="name">vme.meter.form</field>
        <field name="model">vme.meter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Gearchiveerd" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="bv. KV-B1-01"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="association_id"/>
                            <field name="meter_type"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="factor"/>
                            <field name="unit"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="reading_ids">
                        <list editable="top" default_order="date desc">
                            <field name="date"/>
                            <field name="value"/>
                            <field name="source"/>
                            <field name="import_ref" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vme_meter_view_search" model="ir.ui.view">
        <field name="name">vme.meter.search</field>
        <field name="model">vme.meter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lot_id"/>
                <field name="association_id"/>
                <filter name="heating" string="Verwarming" domain="[('meter_type', '=', 'heating')]"/>
                <filter name="water" string="Water" domain="[('meter_type', '=', 'water')]"/>
                <filter name="electricity" string="Elektriciteit" domain="[('meter_type', '=', 'electricity')]"/>
                <separator/>
                <filter name="archived" string="Gearchiveerd" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                    <filter name="group_lot" string="Kavel" context="{'group_by': 'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_meter_action" model="ir.actions.act_window">
        <field name="name">Tellers</field>
        <field name="res_model">vme.meter</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_association': 1}</field>
    </record>

    <record id="vme_meter_reading_view_list" model="ir.ui.view">
        <field name="name">vme.meter.reading.list</field>
        <field name="model">vme.meter.reading</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="association_id" optional="show"/>
                <field name="lot_id"/>
                <field name="meter_id"/>
                <field name="meter_type" optional="show"/>
                <field name="date"/>
                <field name="value"/>
                <field name="unit"/>
                <field name="source" optional="show"/>
                <field name="import_ref" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="vme_meter_reading_view_search" model="ir.ui.view">
        <field name="name">vme.meter.reading.search</field>
        <field name="model">vme.meter.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="meter_id"/>
                <field name="lot_id"/>
                <field name="association_id"/>
                <field name="import_ref"/>
                <filter name="date" string="Datum" date="date"/>
                <group>
                    <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                    <filter name="group_date" string="Opnamedatum" context="{'group_by': 'date:day'}"/>
                    <filter name="group_lot" string="Kavel" context="{'group_by': 'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vme_meter_reading_action" model="ir.actions.act_window">
        <field name="name">Meterstanden</field>
        <field name="res_model">vme.meter.reading</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_association': 1}</field>
    </record>

    <record id="vme_meter_import_wizard_view_form" model="ir.ui.view">
        <field name="name">vme.meter.import.wizard.form</field>
        <field name="model">vme.meter.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Meterstanden inlezen">
                <p>
                    Kies de VME en het CSV-bestand van het meteropnamebedrijf, met de kolommen
                    <code>kavel;teller;soort;datum;stand</code> (en eventueel <code>coefficient</code> en <code>plaats</code>).
                    Klik eerst op <b>Controleren</b>: er wordt dan nog niets opgeslagen.
                </p>
                <group>
                    <field name="association_id"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="state" invisible="1"/>
                </group>
                <field name="report_html" invisible="state != 'checked'"/>
                <footer>
                    <button name="action_check" type="object" string="Controleren" class="btn-primary" invisible="state == 'checked'"/>
                    <button name="action_import" type="object" string="Importeren" class="btn-primary"
                            invisible="state != 'checked' or error_count"/>
                    <field name="error_count" invisible="1"/>
                    <button string="Annuleren" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vme_meter_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Meterstanden inlezen</field>
        <field name="res_model">vme.meter.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_vme_consumption" name="Verbruik" parent="menu_vme_root" sequence="35"/>
    <menuitem id="menu_vme_meter_import" name="Meterstanden inlezen" parent="menu_vme_consumption" action="vme_meter_import_wizard_action" sequence="10"/>
    <menuitem id="menu_vme_meter_reading" name="Meterstanden" parent="menu_vme_consumption" action="vme_meter_reading_action" sequence="20"/>
    <menuitem id="menu_vme_meter" name="Tellers" parent="menu_vme_consumption" action="vme_meter_action" sequence="30"/>
</odoo>
