<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_migration_view_list" model="ir.ui.view">
        <field name="name">vme.migration.list</field>
        <field name="model">vme.migration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="transition_date"/>
                <field name="association_id"/>
                <field name="error_count"/>
                <field name="warning_count"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'checked'"/>
                <field name="create_date" string="Aangemaakt op" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="vme_migration_view_form" model="ir.ui.view">
        <field name="name">vme.migration.form</field>
        <field name="model">vme.migration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_dry_run" type="object" string="Proefrun" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_dry_run" type="object" string="Proefrun opnieuw"
                            invisible="state != 'checked'"/>
                    <button name="action_import" type="object" string="Importeren" class="btn-primary"
                            invisible="state != 'checked' or error_count"
                            confirm="De VME, haar kavels, eigenaars, sleutels, leveranciers en de openingsboeking worden nu aangemaakt. Doorgaan?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_association" type="object" class="oe_stat_button" icon="fa-building"
                                invisible="not association_id">
                            <span class="o_stat_text">VME</span>
                        </button>
                        <button name="action_open_opening_move" type="object" class="oe_stat_button" icon="fa-book"
                                invisible="not opening_move_id">
                            <span class="o_stat_text">Openingsboeking</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_format" readonly="state == 'done'"/>
                            <field name="transition_date" invisible="not transition_date"/>
                        </group>
                        <group>
                            <field name="error_count" invisible="state == 'draft'" decoration-danger="error_count"/>
                            <field name="warning_count" invisible="state == 'draft'" decoration-warning="warning_count"/>
                            <field name="association_id" invisible="1"/>
                            <field name="opening_move_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary" readonly="state == 'done'"/>
                    <div class="text-muted" invisible="state != 'draft'">
                        Voeg de exportbestanden toe (de CSV-bestanden, één Excel-bestand of een zip) en de PDF's van
                        de oudere jaren. Klik daarna op <strong>Proefrun</strong>: die controleert alles en schrijft nog niets weg.
                    </div>
                    <separator string="Rapport" invisible="state == 'draft'"/>
                    <field name="report_html" invisible="state == 'draft'" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vme_migration_action" model="ir.actions.act_window">
        <field name="name">Overstap uit ander pakket</field>
        <field name="res_model">vme.migration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen overstap</p>
            <p>Neem een VME over uit een ander syndicuspakket: laad de exportbestanden op, doe een proefrun en importeer.</p>
        </field>
    </record>

    <menuitem id="menu_vme_migration" name="Overstap uit ander pakket" parent="menu_vme_configuration"
              action="vme_migration_action" sequence="20"/>
</odoo>
