<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Provision calls for more than 20 VMEs are made by this cron, VME per VME (docs/dev/schaal.md). -->
    <record id="ir_cron_vme_provision_call_run" model="ir.cron">
        <field name="name">VME: provisieoproepen op de achtergrond</field>
        <field name="model_id" ref="model_vme_provision_call_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="vme_provision_call_run_view_list" model="ir.ui.view">
        <field name="name">vme.provision.call.run.list</field>
        <field name="model">vme.provision.call.run</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'queued'" decoration-warning="log">
                <field name="create_date" string="Gevraagd op"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="progress"/>
                <field name="state"/>
                <field name="log" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="vme_provision_call_run_view_form" model="ir.ui.view">
        <field name="name">vme.provision.call.run.form</field>
        <field name="model">vme.provision.call.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_open_calls" type="object" string="Provisieoproepen tonen" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'queued'">
                        De provisieoproepen worden op de achtergrond gemaakt, één VME na de andere.
                        U krijgt een melding als ze klaar zijn; herlaad deze pagina om de voortgang te zien.
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="progress"/>
                            <field name="user_id"/>
                            <field name="post_invoices"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="date_due"/>
                        </group>
                    </group>
                    <field name="log" invisible="not log" class="text-warning"/>
                    <field name="association_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vme_provision_call_run_action" model="ir.actions.act_window">
        <field name="name">Provisieoproepen op de achtergrond</field>
        <field name="res_model">vme.provision.call.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vme_provision_call_run" name="Provisieoproepen op de achtergrond" parent="menu_vme_configuration"
              action="vme_provision_call_run_action" sequence="50"/>
</odoo>
