<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Management agreement -->
    <record id="vme_management_agreement_view_list" model="ir.ui.view">
        <field name="name">vme.management.agreement.list</field>
        <field name="model">vme.management.agreement</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_create_fee_invoice" type="object" string="Ereloonfactuur maken"/>
                </header>
                <field name="association_id"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="fee_basis"/>
                <field name="fee_amount"/>
                <field name="billing_period"/>
                <field name="indexation" optional="show"/>
                <field name="current_monthly_fee" string="Vast ereloon per maand"/>
                <field name="service_to_invoice_count" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="vme_management_agreement_view_form" model="ir.ui.view">
        <field name="name">vme.management.agreement.form</field>
        <field name="model">vme.management.agreement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_fee_invoice" type="object" string="Ereloonfactuur maken"
                            class="btn-primary" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_fee_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="fee_invoice_count" widget="statinfo" string="Ereloonfacturen"/>
                        </button>
                        <button name="action_open_services" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="service_to_invoice_count" widget="statinfo" string="Te factureren"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Gearchiveerd" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Overeenkomst">
                            <field name="association_id"/>
                            <field name="syndic_company_id" options="{'no_create': True}"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Vast ereloon">
                            <field name="fee_basis" widget="radio" options="{'horizontal': true}"/>
                            <field name="fee_amount"/>
                            <field name="billing_period" widget="radio" options="{'horizontal': true}"/>
                            <field name="unit_count" invisible="fee_basis != 'lot'"/>
                            <field name="current_unit_fee"/>
                            <field name="current_monthly_fee"/>
                        </group>
                        <group string="Indexering">
                            <field name="indexation"/>
                            <field name="index_base_month" invisible="indexation != 'cpi'"/>
                            <field name="index_base_value" invisible="indexation != 'cpi'"/>
                            <field name="index_percent" invisible="indexation != 'percent'"/>
                            <field name="index_rates" invisible="indexation == 'none'"/>
                            <field name="current_factor" invisible="indexation == 'none'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prijslijst extra prestaties" name="rates">
                            <field name="rate_ids">
                                <list editable="bottom">
                                    <field name="service_type"/>
                                    <field name="price"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prestaties" name="services">
                            <field name="service_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="service_type"/>
                                    <field name="name"/>
                                    <field name="amount" sum="Totaal"/>
                                    <field name="state" widget="badge" decoration-info="state == 'to_invoice'"
                                           decoration-success="state == 'invoiced'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Opmerkingen" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vme_management_agreement_action" model="ir.actions.act_window">
        <field name="name">Beheerovereenkomsten</field>
        <field name="res_model">vme.management.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Leg de beheerovereenkomst van een VME vast</p>
            <p>Vast ereloon per kavel of per VME, indexering en de prijslijst van de extra prestaties.</p>
        </field>
    </record>

    <!-- Service lines -->
    <record id="vme_service_line_view_list" model="ir.ui.view">
        <field name="name">vme.service.line.list</field>
        <field name="model">vme.service.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="association_id"/>
                <field name="service_type"/>
                <field name="name"/>
                <field name="source_name" optional="show"/>
                <field name="recharge_partner_id" optional="hide"/>
                <field name="recharge_invoice_id" optional="hide"/>
                <field name="amount" sum="Totaal"/>
                <field name="state" widget="badge" decoration-info="state == 'to_invoice'"
                       decoration-success="state == 'invoiced'" decoration-muted="state == 'no_charge'"/>
                <field name="invoice_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="vme_service_line_view_form" model="ir.ui.view">
        <field name="name">vme.service.line.form</field>
        <field name="model">vme.service.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_source" type="object" string="Bron openen" invisible="not res_model"/>
                    <button name="action_prepare_recharge_invoice" type="object" string="Doorrekening klaarzetten"
                            invisible="not recharge_partner_id or recharge_invoice_id or no_charge"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="association_id" readonly="state == 'invoiced'"/>
                            <field name="agreement_id" readonly="state == 'invoiced'"/>
                            <field name="service_type" readonly="state == 'invoiced'"/>
                            <field name="name" readonly="state == 'invoiced'"/>
                            <field name="date" readonly="state == 'invoiced'"/>
                        </group>
                        <group>
                            <field name="quantity" readonly="state == 'invoiced'"/>
                            <field name="price_unit" readonly="state == 'invoiced'"/>
                            <field name="amount"/>
                            <field name="no_charge" readonly="state == 'invoiced'"/>
                            <field name="recharge_partner_id"/>
                            <field name="recharge_invoice_id" invisible="not recharge_invoice_id"/>
                            <field name="source_name" invisible="not res_model"/>
                            <field name="invoice_id" invisible="not invoice_id"/>
                            <field name="res_model" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vme_service_line_view_search" model="ir.ui.view">
        <field name="name">vme.service.line.search</field>
        <field name="model">vme.service.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="association_id"/>
                <field name="name"/>
                <filter name="to_invoice" string="Te factureren" domain="[('state', '=', 'to_invoice')]"/>
                <filter name="invoiced" string="Gefactureerd" domain="[('state', '=', 'invoiced')]"/>
                <separator/>
                <filter name="group_association" string="VME" context="{'group_by': 'association_id'}"/>
                <filter name="group_type" string="Prestatie" context="{'group_by': 'service_type'}"/>
            </search>
        </field>
    </record>

    <record id="vme_service_line_action" model="ir.actions.act_window">
        <field name="name">Prestaties</field>
        <field name="res_model">vme.service.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_invoice': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nog geen prestaties</p>
            <p>Prestaties ontstaan vanzelf bij een verkoopdossier, een schadegeval, een buitengewone AV of een
               aangetekende zending. U kunt er ook zelf een toevoegen.</p>
        </field>
    </record>

    <!-- Mandate of the syndic -->
    <record id="vme_syndic_mandate_view_list" model="ir.ui.view">
        <field name="name">vme.syndic.mandate.list</field>
        <field name="model">vme.syndic.mandate</field>
        <field name="arch" type="xml">
            <list decoration-muted="renewal_state == 'renewed'">
                <field name="association_id"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="renewal_assembly_year" options="{'enable_formatting': false}"/>
                <field name="renewal_state" widget="badge" decoration-success="renewal_state in ('ok', 'renewed')"
                       decoration-warning="renewal_state in ('plan', 'decided')"
                       decoration-danger="renewal_state in ('urgent', 'expired')"/>
                <field name="posting_state" widget="badge" decoration-success="posting_state == 'posted'"
                       decoration-warning="posting_state == 'todo'" decoration-danger="posting_state == 'late'"/>
            </list>
        </field>
    </record>

    <record id="vme_syndic_mandate_view_form" model="ir.ui.view">
        <field name="name">vme.syndic.mandate.form</field>
        <field name="model">vme.syndic.mandate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_renewal_item" type="object" string="Agendapunt herbenoeming"
                            invisible="not id or renewal_item_id or renewal_state in ('renewed', 'expired', 'ok')"/>
                    <button name="action_renew" type="object" string="Hernieuwen" class="btn-primary"
                            invisible="not id or renewal_state != 'decided'"/>
                    <button name="action_make_posting" type="object" string="Aanplakbrief maken" invisible="not id"/>
                    <button name="action_mark_posted" type="object" string="Aangeplakt"
                            invisible="not id or posted_date"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="renewal_state not in ('plan', 'decided')">
                        <field name="renewal_text" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="renewal_state not in ('urgent', 'expired')">
                        <field name="renewal_text" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="posting_state != 'late'">
                        De aanstelling moest uiterlijk op <field name="posting_deadline" readonly="1"/> aan de ingang
                        aangeplakt zijn.
                    </div>
                    <group>
                        <group string="Mandaat">
                            <field name="association_id"/>
                            <field name="partner_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="appointment_item_id"/>
                            <field name="previous_mandate_id"/>
                            <field name="next_mandate_id" invisible="not next_mandate_id"/>
                        </group>
                        <group string="Herbenoeming">
                            <field name="renewal_assembly_year" options="{'enable_formatting': false}"/>
                            <field name="renewal_period_start"/>
                            <field name="renewal_assembly_id"/>
                            <field name="renewal_item_id"/>
                            <field name="renewal_state"/>
                        </group>
                        <group string="Aanplakking aan de ingang">
                            <field name="posting_deadline"/>
                            <field name="posted_date"/>
                            <field name="posting_document_id"/>
                            <field name="posting_state"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vme_syndic_mandate_view_search" model="ir.ui.view">
        <field name="name">vme.syndic.mandate.search</field>
        <field name="model">vme.syndic.mandate</field>
        <field name="arch" type="xml">
            <search>
                <field name="association_id"/>
                <filter name="current" string="Lopend" domain="[('is_current', '=', True)]"/>
                <filter name="renewal" string="Herbenoeming te plannen"
                        domain="[('renewal_state', 'in', ['plan', 'urgent', 'decided'])]"/>
                <filter name="posting" string="Aanplakking ontbreekt" domain="[('posting_state', 'in', ['todo', 'late'])]"/>
            </search>
        </field>
    </record>

    <record id="vme_syndic_mandate_action" model="ir.actions.act_window">
        <field name="name">Mandaten syndicus</field>
        <field name="res_model">vme.syndic.mandate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
    </record>

    <!-- Fee invoices of the office -->
    <record id="vme_fee_invoice_action" model="ir.actions.act_window">
        <field name="name">Ereloonfacturen</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vme_fee_agreement_id', '!=', False), ('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Geen ereloonfacturen in de gekozen bedrijven</p>
            <p>Uw ereloonfacturen staan in het bedrijf van uw kantoor. Vink rechtsboven in de bedrijvenkiezer
               uw kantoor aan, of maak nieuwe facturen via Ereloonfacturen maken.</p>
        </field>
    </record>

    <!-- Consumer price index -->
    <record id="vme_consumer_price_index_view_list" model="ir.ui.view">
        <field name="name">vme.consumer.price.index.list</field>
        <field name="model">vme.consumer.price.index</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="month"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <record id="vme_consumer_price_index_action" model="ir.actions.act_window">
        <field name="name">Consumptieprijsindex</field>
        <field name="res_model">vme.consumer.price.index</field>
        <field name="view_mode">list</field>
    </record>

    <!-- VME form: the syndic tab -->
    <record id="vme_association_view_form_syndic" model="ir.ui.view">
        <field name="name">vme.association.form.syndic</field>
        <field name="model">vme.association</field>
        <field name="inherit_id" ref="vme_association_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Syndicus" name="syndic" groups="account.group_account_invoice">
                    <field name="syndic_renewal_state" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="syndic_renewal_state not in ('plan', 'urgent', 'decided', 'expired')">
                        <field name="syndic_renewal_text"/>
                    </div>
                    <group>
                        <group>
                            <field name="current_agreement_id"/>
                            <field name="current_syndic_mandate_id"/>
                        </group>
                        <group>
                            <button name="action_open_agreements" type="object" string="Beheerovereenkomsten"
                                    class="btn-link" colspan="2"/>
                            <button name="action_open_syndic_mandates" type="object" string="Mandaten syndicus"
                                    class="btn-link" colspan="2"/>
                            <button name="action_open_service_lines" type="object" string="Prestaties syndicus"
                                    class="btn-link" colspan="2"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Sale file: the invoice that recharges the costs of the information to the seller -->
    <record id="vme_sale_file_view_form_recharge" model="ir.ui.view">
        <field name="name">vme.sale.file.form.recharge</field>
        <field name="model">vme.sale.file</field>
        <field name="inherit_id" ref="vme_sale_file_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <field name="recharge_invoice_id" invisible="1"/>
                    <button name="action_open_recharge_invoice" type="object" class="oe_stat_button"
                            icon="fa-file-text-o" string="Doorrekening verkoper" invisible="not recharge_invoice_id"
                            groups="account.group_account_invoice"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Invoice form: link between the fee invoice of the office and the bill in the VME -->
    <record id="view_move_form_vme_fee" model="ir.ui.view">
        <field name="name">account.move.form.vme.fee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="vme_fee_bill_id" invisible="1"/>
                <field name="vme_fee_invoice_id" invisible="1"/>
                <button name="action_open_vme_fee_bill" type="object" class="oe_stat_button" icon="fa-exchange"
                        string="Factuur in de VME" invisible="not vme_fee_bill_id"/>
                <button name="action_open_vme_fee_bill" type="object" class="oe_stat_button" icon="fa-exchange"
                        string="Ereloonfactuur syndicus" invisible="not vme_fee_invoice_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="after">
                <field name="vme_recharge_partner_id" optional="show" readonly="1"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund') or not parent.vme_fee_invoice_id"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="vme_fee_agreement_id" invisible="not vme_fee_agreement_id" readonly="1"/>
                <label for="vme_period_start" string="Ereloonperiode" invisible="not vme_fee_agreement_id"/>
                <div class="o_row" invisible="not vme_fee_agreement_id">
                    <field name="vme_period_start" nolabel="1" readonly="1"/>
                    <span>tot</span>
                    <field name="vme_period_end" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_vme_syndic_root" name="Syndicus" parent="menu_vme_root" sequence="85"
              groups="account.group_account_invoice"/>
    <menuitem id="menu_vme_management_agreement" name="Beheerovereenkomsten" parent="menu_vme_syndic_root"
              action="vme_management_agreement_action" sequence="10"/>
    <menuitem id="menu_vme_service_line" name="Prestaties" parent="menu_vme_syndic_root"
              action="vme_service_line_action" sequence="20"/>
    <menuitem id="menu_vme_fee_invoice_wizard" name="Ereloonfacturen maken" parent="menu_vme_syndic_root"
              action="vme_fee_invoice_wizard_action" sequence="30"/>
    <menuitem id="menu_vme_fee_invoice" name="Ereloonfacturen" parent="menu_vme_syndic_root"
              action="vme_fee_invoice_action" sequence="40"/>
    <menuitem id="menu_vme_syndic_mandate" name="Mandaten" parent="menu_vme_syndic_root"
              action="vme_syndic_mandate_action" sequence="50"/>
    <menuitem id="menu_vme_consumer_price_index" name="Consumptieprijsindex" parent="menu_vme_configuration"
              action="vme_consumer_price_index_action" sequence="60"/>
</odoo>
