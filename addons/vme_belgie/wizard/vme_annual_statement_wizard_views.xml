<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_annual_statement_wizard_view_form" model="ir.ui.view">
        <field name="name">vme.annual.statement.wizard.form</field>
        <field name="model">vme.annual.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Jaarafrekening">
                <group>
                    <group>
                        <field name="association_id" options="{'no_create': True}"/>
                        <field name="year" options="{'enable_formatting': false}"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="preview_html" nolabel="1" invisible="not association_id"/>
                <footer>
                    <button name="action_print" type="object" string="Afdrukken (PDF)" class="btn-primary"/>
                    <button string="Sluiten" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vme_annual_statement_wizard_action" model="ir.actions.act_window">
        <field name="name">Jaarafrekening</field>
        <field name="res_model">vme.annual.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_vme_annual_statement" name="Jaarafrekening" parent="menu_vme_root"
              action="vme_annual_statement_wizard_action" sequence="48"/>
</odoo>
