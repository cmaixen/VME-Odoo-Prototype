<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_fee_invoice_wizard_form" model="ir.ui.view">
        <field name="name">vme.fee.invoice.wizard.form</field>
        <field name="model">vme.fee.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Ereloonfacturen maken">
                <p class="text-muted">
                    Per beheerovereenkomst één conceptfactuur per maand of kwartaal: het vaste ereloon plus de
                    prestaties die nog te factureren zijn. Niets wordt bevestigd of verstuurd; u kijkt elke
                    factuur na en bevestigt ze zelf.
                </p>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="association_ids" widget="many2many_tags" placeholder="Alle VME's met een overeenkomst"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Conceptfacturen maken" class="btn-primary"/>
                    <button string="Annuleren" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vme_fee_invoice_wizard_action" model="ir.actions.act_window">
        <field name="name">Ereloonfacturen maken</field>
        <field name="res_model">vme.fee.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_vme_association"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
