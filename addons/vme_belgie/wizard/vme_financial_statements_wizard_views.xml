<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vme_financial_statements_wizard_view_form" model="ir.ui.view">
        <field name="name">vme.financial.statements.wizard.form</field>
        <field name="model">vme.financial.statements.wizard</field>
        <field name="arch" type="xml">
            <form string="Balans en resultatenrekening">
                <group>
                    <group>
                        <field name="association_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="year" options="{'enable_formatting': false}"/>
                    </group>
                </group>
                <field name="preview_html" nolabel="1" invisible="not association_id"/>
                <footer>
                    <button name="action_print" type="object" string="Afdrukken (PDF)" class="btn-primary"/>
                    <button string="Sluiten" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vme_financial_statements_wizard_action" model="ir.actions.act_window">
        <field name="name">Balans en resultatenrekening</field>
        <field name="res_model">vme.financial.statements.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>

    <menuitem id="menu_vme_financial_statements" name="Balans en resultatenrekening" parent="menu_vme_root"
              action="vme_financial_statements_wizard_action" sequence="49"/>
</odoo>
