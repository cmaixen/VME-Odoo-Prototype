    <!-- The auditor never writes rent records, even if he were given the office company by mistake. -->
    <record id="rule_auditor_no_write_rent_contract" model="ir.rule">
        <field name="name">Commissaris: geen wijzigingen aan vme.rent.contract</field>
        <field name="model_id" ref="model_vme_rent_contract"/>
        <field name="groups" eval="[Command.link(ref('vme_belgie.group_vme_auditor'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
