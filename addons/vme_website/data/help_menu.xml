<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same pattern as vme_belgie/data/help_menu.xml: the knowledge base URL is a system parameter. -->
    <record id="action_help_website" model="ir.actions.server">
        <field name="name">Help: website en inloggen</field>
        <field name="model_id" ref="vme_belgie.model_vme_association"/>
        <field name="state">code</field>
        <field name="code">action = {"type": "ir.actions.act_url", "target": "new", "url": env["ir.config_parameter"].sudo().get_param("vme_belgie.help_url", "").rstrip("/") + "/website-en-inloggen.md"}</field>
    </record>
    <menuitem id="menu_vme_help_website" name="De website en inloggen" parent="vme_belgie.menu_vme_help" action="action_help_website" sequence="155"/>
</odoo>
