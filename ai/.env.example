# Copy to ai/.env and fill in. ai/.env is in .gitignore: never commit a real key.

# Anthropic API key for Claude (https://console.anthropic.com). Not needed with --mock.
ANTHROPIC_API_KEY=

# Odoo to read the VME's from and to put the activities on.
ODOO_URL=http://localhost:8069
ODOO_DB=vme_demo
ODOO_USER=admin
# Password or, better, an API key of this user (Odoo: Mijn profiel > Accountbeveiliging).
ODOO_PASSWORD=admin

# Optional: id of the Odoo user who gets the to-dos (default: the user above).
# ODOO_ACTIVITY_USER_ID=
