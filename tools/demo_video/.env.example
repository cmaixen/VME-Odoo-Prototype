# Copy to .env (in .gitignore). Settings for the voice-over of the demo video (docs/dev/demo-video.md).
# say: a macOS voice (default, free, offline) | elevenlabs: voice.py with the API key below |
# connector: clips made with the ElevenLabs connector in Claude | none: captions only
VOICE_ENGINE=say
SAY_VOICE=Ellen
SAY_RATE=175
ELEVENLABS_API_KEY=
# Optional: a specific ElevenLabs voice; without it voice.py picks a Dutch voice of the account.
ELEVENLABS_VOICE_ID=
